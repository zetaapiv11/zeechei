/* =========================================================
   ZEETASI — design tokens
   ========================================================= */
:root{
  --bg: #0a0b10;
  --bg-soft: #0d0f16;
  --surface: #13151f;
  --surface-2: #191c29;
  --border: rgba(255,255,255,.08);
  --border-strong: rgba(255,255,255,.14);

  --text: #eceef6;
  --text-muted: #8b90a6;
  --text-dim: #5c6178;

  --violet: #7c5cff;
  --violet-soft: #b79bff;
  --cyan: #21e6c1;
  --gold: #ffc857;
  --red: #ff5c7a;

  --grad-brand: linear-gradient(120deg, var(--violet), var(--cyan));

  --font-display: 'Space Grotesk', 'Segoe UI', sans-serif;
  --font-body: 'Inter', 'Segoe UI', sans-serif;
  --font-mono: 'JetBrains Mono', 'Courier New', monospace;

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;

  --shadow-glow: 0 0 60px rgba(124,92,255,.18);
  --ease: cubic-bezier(.22,.9,.3,1);

  --nav-h: 72px;
  --container: 1180px;
}

*,*::before,*::after{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }
@media (prefers-reduced-motion: reduce){
  html{ scroll-behavior:auto; }
  *,*::before,*::after{ animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
}

body{
  margin:0;
  background:
    radial-gradient(1200px 600px at 15% -10%, rgba(124,92,255,.16), transparent 60%),
    radial-gradient(1000px 700px at 90% 10%, rgba(33,230,193,.10), transparent 55%),
    var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}

h1,h2,h3{ font-family:var(--font-display); line-height:1.1; margin:0; letter-spacing:-.01em; }
p{ margin:0; }
a{ color:inherit; text-decoration:none; }
ul,ol{ margin:0; padding:0; list-style:none; }
img{ max-width:100%; display:block; }
button{ font:inherit; color:inherit; background:none; border:0; cursor:pointer; }
code{ font-family:var(--font-mono); }

.skip-link{
  position:absolute; left:-999px; top:0; background:var(--violet); color:#fff;
  padding:.6em 1em; border-radius:0 0 8px 0; z-index:1000;
}
.skip-link:focus{ left:0; }

:focus-visible{ outline:2px solid var(--cyan); outline-offset:3px; border-radius:4px; }

.section__inner{
  max-width:var(--container);
  margin:0 auto;
  padding:96px 24px;
}
.section__head{ max-width:640px; margin-bottom:44px; }
.eyebrow{
  font-family:var(--font-mono);
  font-size:.8rem;
  color:var(--cyan);
  margin:0 0 10px;
}
.section__title{ font-size:clamp(1.8rem, 3.2vw, 2.6rem); }
.section__desc{ color:var(--text-muted); margin-top:14px; max-width:56ch; }

.grad-text{
  background:var(--grad-brand);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

/* buttons */
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:.85em 1.5em;
  border-radius:12px;
  font-weight:600;
  font-size:.95rem;
  transition:transform .2s var(--ease), box-shadow .2s var(--ease), background .2s var(--ease), border-color .2s var(--ease);
  white-space:nowrap;
}
.btn--primary{
  background:var(--grad-brand);
  color:#0a0b10;
  box-shadow:0 8px 30px rgba(124,92,255,.35);
}
.btn--primary:hover{ transform:translateY(-2px); box-shadow:0 12px 36px rgba(124,92,255,.5); }
.btn--ghost{
  background:transparent;
  border:1px solid var(--border-strong);
  color:var(--text);
}
.btn--ghost:hover{ border-color:var(--cyan); color:var(--cyan); }
.btn--sm{ padding:.6em 1.1em; font-size:.85rem; }
.btn--lg{ padding:1em 1.9em; font-size:1rem; }
.btn--block{ width:100%; }

/* =========================================================
   NAVBAR
   ========================================================= */
.navbar{
  position:sticky; top:0; z-index:200;
  height:var(--nav-h);
  display:flex; align-items:center;
  border-bottom:1px solid transparent;
  transition:background .25s var(--ease), border-color .25s var(--ease), backdrop-filter .25s var(--ease);
}
.navbar.is-scrolled{
  background:rgba(10,11,16,.72);
  backdrop-filter:blur(14px);
  border-bottom-color:var(--border);
}
.navbar__inner{
  width:100%; max-width:var(--container); margin:0 auto; padding:0 24px;
  display:flex; align-items:center; justify-content:space-between; gap:24px;
}
.navbar__brand{ display:flex; align-items:center; gap:10px; }
.navbar__name{ font-family:var(--font-display); font-weight:700; font-size:1.15rem; letter-spacing:-.02em; }
.navbar__menu{ display:flex; gap:28px; }
.navlink{
  font-size:.92rem; color:var(--text-muted); position:relative; padding:6px 0;
  transition:color .2s var(--ease);
}
.navlink::after{
  content:""; position:absolute; left:0; right:0; bottom:0; height:2px;
  background:var(--grad-brand); transform:scaleX(0); transform-origin:left; transition:transform .25s var(--ease);
}
.navlink:hover, .navlink.is-active{ color:var(--text); }
.navlink.is-active::after, .navlink:hover::after{ transform:scaleX(1); }

.navbar__actions{ display:flex; align-items:center; gap:14px; }

.hamburger{
  display:none; flex-direction:column; justify-content:center; gap:5px;
  width:38px; height:38px; border-radius:8px;
}
.hamburger span{ width:20px; height:2px; background:var(--text); margin:0 auto; transition:transform .25s var(--ease), opacity .2s var(--ease); }
.hamburger.is-active span:nth-child(1){ transform:translateY(7px) rotate(45deg); }
.hamburger.is-active span:nth-child(2){ opacity:0; }
.hamburger.is-active span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); }

.mobile-menu{
  display:none; flex-direction:column; gap:2px;
  position:absolute; top:var(--nav-h); left:0; right:0;
  background:rgba(12,13,20,.98); backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:10px 24px 20px;
  transform:translateY(-8px); opacity:0; pointer-events:none;
  transition:transform .25s var(--ease), opacity .25s var(--ease);
}
.mobile-menu.is-open{ transform:translateY(0); opacity:1; pointer-events:auto; }
.mobile-menu__link{ padding:14px 4px; border-bottom:1px solid var(--border); color:var(--text-muted); }
.mobile-menu__link:hover{ color:var(--text); }
.mobile-menu .btn{ margin-top:16px; }

/* =========================================================
   HERO
   ========================================================= */
.hero{ position:relative; padding-top:16px; overflow:hidden; }
.hero__field{
  position:absolute; inset:0; z-index:0; pointer-events:none;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size:44px 44px;
  mask-image:radial-gradient(ellipse 70% 60% at 50% 20%, #000 40%, transparent 85%);
}
.hero__inner{
  position:relative; z-index:1;
  max-width:var(--container); margin:0 auto; padding:64px 24px 100px;
  display:grid; grid-template-columns:1.05fr .95fr; gap:56px; align-items:center;
}
.hero__kicker{
  font-family:var(--font-mono); font-size:.82rem; color:var(--violet-soft);
  border:1px solid var(--border-strong); display:inline-block;
  padding:6px 14px; border-radius:999px; margin-bottom:22px;
}
.hero__title{ font-size:clamp(2.6rem, 6vw, 4.2rem); }
.hero__subtitle{ font-size:clamp(1.05rem, 2vw, 1.3rem); color:var(--text-muted); margin-top:14px; font-weight:500; }
.hero__desc{ margin-top:20px; color:var(--text-muted); max-width:52ch; font-size:1.02rem; }
.hero__actions{ margin-top:34px; display:flex; gap:16px; flex-wrap:wrap; }

.hero__panel{ display:flex; flex-direction:column; align-items:center; gap:28px; }

.bot-avatar{ position:relative; width:120px; height:120px; }
.bot-avatar__ring{
  position:absolute; inset:-14px; border-radius:50%;
  border:1px dashed var(--border-strong);
}
.bot-avatar__glow{
  position:absolute; inset:-30px; border-radius:50%;
  background:radial-gradient(circle, rgba(124,92,255,.35), transparent 70%);
  filter:blur(6px);
}
.bot-avatar__mark{ position:relative; z-index:1; }
.bot-avatar__status{
  position:absolute; bottom:4px; right:4px; width:16px; height:16px; border-radius:50%;
  background:var(--cyan); border:3px solid var(--bg); z-index:2;
  box-shadow:0 0 12px var(--cyan);
}

.terminal{
  width:100%; max-width:420px;
  background:rgba(19,21,31,.85);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  overflow:hidden;
  backdrop-filter:blur(10px);
  box-shadow:var(--shadow-glow);
}
.terminal--wide{ max-width:100%; }
.terminal__bar{
  display:flex; align-items:center; gap:8px;
  padding:12px 14px; background:rgba(255,255,255,.03); border-bottom:1px solid var(--border);
}
.terminal__dot{ width:10px; height:10px; border-radius:50%; background:var(--border-strong); }
.terminal__dot:nth-child(1){ background:var(--red); }
.terminal__dot:nth-child(2){ background:var(--gold); }
.terminal__dot:nth-child(3){ background:var(--cyan); }
.terminal__label{ margin-left:auto; font-family:var(--font-mono); font-size:.75rem; color:var(--text-dim); }
.terminal__body{ padding:20px; font-family:var(--font-mono); font-size:.9rem; min-height:170px; }
.terminal__line{ margin-bottom:6px; display:flex; gap:8px; }
.terminal__prompt{ color:var(--cyan); }
.terminal__cmd{ color:var(--text); }
.terminal__cursor{ display:inline-block; width:7px; background:var(--cyan); margin-left:2px; animation:blink 1s step-end infinite; }
.terminal__response{ color:var(--text-muted); white-space:pre-line; margin:8px 0 18px; }
.terminal__response b{ color:var(--gold); font-weight:600; }
@keyframes blink{ 50%{ opacity:0; } }

/* =========================================================
   PREFIX SECTION
   ========================================================= */
.prefix{ border-top:1px solid var(--border); border-bottom:1px solid var(--border); background:var(--bg-soft); }
.prefix__grid{ display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center; }
.prefix__commands{ display:flex; flex-wrap:wrap; gap:10px; }
.prefix__commands code{
  background:var(--surface); border:1px solid var(--border-strong);
  padding:10px 16px; border-radius:8px; font-size:.9rem; color:var(--violet-soft);
}

/* =========================================================
   FEATURE GRID
   ========================================================= */
.feature-grid{
  display:grid; grid-template-columns:repeat(3, 1fr); gap:18px;
}
.feature-card{
  background:var(--surface);
  border:1px solid var(--border);
  padding:26px 24px;
  clip-path:polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
  transition:border-color .25s var(--ease), transform .25s var(--ease), background .25s var(--ease);
}
.feature-card:hover{ border-color:var(--border-strong); background:var(--surface-2); transform:translateY(-3px); }
.feature-card__icon{ font-size:1.6rem; }
.feature-card__title{ font-family:var(--font-display); font-weight:600; margin-top:12px; font-size:1.05rem; }
.feature-card__desc{ color:var(--text-muted); font-size:.92rem; margin-top:8px; }
.feature-card__tags{ display:flex; flex-wrap:wrap; gap:6px; margin-top:14px; }
.feature-card__tags span{
  font-family:var(--font-mono); font-size:.72rem; color:var(--text-dim);
  border:1px solid var(--border); padding:3px 9px; border-radius:999px;
}

/* =========================================================
   GAMES
   ========================================================= */
.game-grid{ display:grid; grid-template-columns:repeat(4, 1fr); gap:16px; }
.game-card{
  background:linear-gradient(155deg, var(--surface), var(--surface-2));
  border:1px solid var(--border);
  border-radius:var(--radius-md);
  padding:22px;
  transition:border-color .25s var(--ease), transform .25s var(--ease);
}
.game-card:hover{ border-color:var(--violet); transform:translateY(-3px); }
.game-card__icon{ font-size:1.5rem; }
.game-card__name{ font-family:var(--font-display); font-weight:600; margin-top:10px; }
.game-card__desc{ color:var(--text-muted); font-size:.88rem; margin-top:6px; }
.game-card__cmd{
  display:inline-block; margin-top:14px; font-family:var(--font-mono); font-size:.78rem;
  color:var(--cyan); border:1px solid var(--border); padding:4px 10px; border-radius:6px;
}

/* =========================================================
   ECONOMY
   ========================================================= */
.economy{ background:var(--bg-soft); border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
.economy__inner{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; }
.economy__note{
  margin-top:18px; font-size:.85rem; color:var(--gold);
  border:1px solid rgba(255,200,87,.3); background:rgba(255,200,87,.06);
  padding:12px 16px; border-radius:10px;
}
.economy__flow{ display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
.economy__flow li{
  font-family:var(--font-mono); font-size:.82rem;
  background:var(--surface); border:1px solid var(--border-strong);
  padding:9px 15px; border-radius:8px;
}
.economy__flow li:not(:last-child)::after{ content:"→"; margin-left:10px; color:var(--text-dim); }

/* =========================================================
   AI
   ========================================================= */
.ai__grid{ display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:56px; }
.ai-card{
  background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-md); padding:28px;
}
.ai-card h3{ font-size:1.15rem; }
.ai-card p{ color:var(--text-muted); margin-top:10px; }

.ai-flow{ display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:0; }
.ai-flow__node{
  font-family:var(--font-mono); font-size:.82rem;
  border:1px solid var(--border-strong); border-radius:10px;
  padding:12px 16px; background:var(--surface);
}
.ai-flow__line{
  width:44px; height:2px; margin:0 6px;
  background:linear-gradient(90deg, var(--violet), var(--cyan));
  background-size:200% 100%;
  animation:flow 2.4s linear infinite;
}
@keyframes flow{ from{ background-position:200% 0; } to{ background-position:-200% 0; } }

/* =========================================================
   MUSIC
   ========================================================= */
.music{ background:var(--bg-soft); border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
.music__inner{ display:grid; grid-template-columns:1.2fr .8fr; gap:48px; align-items:start; }
.music__controls{ display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; }
.music__controls span{
  font-size:.85rem; border:1px solid var(--border-strong); border-radius:999px;
  padding:8px 14px; color:var(--text-muted);
}
.music__example{
  background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-md);
  padding:24px;
}
.music__example-label{ font-family:var(--font-mono); color:var(--cyan); font-size:.8rem; margin-bottom:10px; }
.music__example code{ font-size:1rem; color:var(--violet-soft); }
.music__example-note{ margin-top:14px; font-size:.8rem; color:var(--text-dim); }
.music__example-note code{ font-size:.78rem; color:var(--text-dim); }

/* =========================================================
   MODERATION
   ========================================================= */
.mod-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; }
.mod-card{
  border:1px solid var(--border); border-radius:var(--radius-sm);
  padding:20px; text-align:center; color:var(--text-muted); font-size:.92rem;
  background:var(--surface); transition:border-color .2s var(--ease), color .2s var(--ease);
}
.mod-card:hover{ border-color:var(--cyan); color:var(--text); }

/* =========================================================
   COMMAND SHOWCASE
   ========================================================= */
.showcase__tabs{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
.showcase__tab{
  font-size:.85rem; padding:9px 16px; border-radius:999px;
  border:1px solid var(--border-strong); color:var(--text-muted);
  transition:background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease);
}
.showcase__tab.is-active{ background:var(--grad-brand); color:#0a0b10; border-color:transparent; font-weight:600; }
.showcase__tab:hover:not(.is-active){ border-color:var(--cyan); color:var(--text); }
.showcase__panel .terminal__body{ min-height:220px; }
.showcase__row{ display:flex; justify-content:space-between; gap:14px; padding:10px 0; border-bottom:1px solid var(--border); }
.showcase__row:last-child{ border-bottom:0; }
.showcase__row code{ color:var(--violet-soft); }
.showcase__row span{ color:var(--text-dim); font-size:.82rem; }

/* =========================================================
   STATS
   ========================================================= */
.stats__grid{ display:grid; grid-template-columns:repeat(4, 1fr); gap:18px; padding-top:64px; padding-bottom:64px; }
.stat-card{
  text-align:center; border:1px solid var(--border); border-radius:var(--radius-md);
  padding:32px 16px; background:var(--surface);
}
.stat-card__value{
  display:block; font-family:var(--font-display); font-size:2.2rem; font-weight:700;
  background:var(--grad-brand); -webkit-background-clip:text; background-clip:text; color:transparent;
}
.stat-card__value--text{ font-size:1.8rem; }
.stat-card__label{ display:block; margin-top:8px; color:var(--text-muted); font-size:.85rem; }

/* =========================================================
   WHY
   ========================================================= */
.why-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; }
.why-card{
  display:flex; align-items:center; gap:12px;
  border:1px solid var(--border); border-radius:var(--radius-sm);
  padding:18px 20px; background:var(--surface);
  font-size:.95rem; transition:border-color .2s var(--ease);
}
.why-card:hover{ border-color:var(--violet); }
.why-card__icon{ font-size:1.3rem; }

/* =========================================================
   FAQ
   ========================================================= */
.faq__inner{ max-width:820px; }
.faq__item{ border-bottom:1px solid var(--border); }
.faq__q{
  width:100%; display:flex; justify-content:space-between; align-items:center;
  padding:22px 4px; text-align:left; font-family:var(--font-display); font-weight:600; font-size:1.02rem;
}
.faq__q-icon{ font-size:1.3rem; color:var(--cyan); transition:transform .25s var(--ease); flex:none; margin-left:16px; }
.faq__item.is-open .faq__q-icon{ transform:rotate(45deg); }
.faq__a{ max-height:0; overflow:hidden; transition:max-height .3s var(--ease); }
.faq__a p{ padding:0 4px 22px; color:var(--text-muted); }

/* =========================================================
   CTA
   ========================================================= */
.cta{
  background:
    radial-gradient(700px 300px at 50% 0%, rgba(124,92,255,.25), transparent 70%),
    var(--bg-soft);
  border-top:1px solid var(--border);
}
.cta__inner{ text-align:center; max-width:680px; }
.cta__title{ font-size:clamp(1.8rem, 3.6vw, 2.6rem); }
.cta__subtitle{ color:var(--text-muted); margin-top:16px; }
.cta__actions{ margin-top:32px; display:flex; justify-content:center; gap:16px; flex-wrap:wrap; }

/* =========================================================
   FOOTER
   ========================================================= */
.footer{ border-top:1px solid var(--border); background:var(--bg); }
.footer__inner{
  display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:24px;
  padding-top:48px; padding-bottom:48px;
}
.footer__brand p{ color:var(--text-dim); font-size:.85rem; margin-top:6px; }
.footer__links{ display:flex; flex-wrap:wrap; gap:20px; }
.footer__links a{ color:var(--text-muted); font-size:.88rem; }
.footer__links a:hover{ color:var(--text); }
.footer__discord{
  display:inline-flex; align-items:center; gap:8px;
  border:1px solid var(--border-strong); border-radius:999px; padding:9px 18px;
  font-size:.85rem; color:var(--text);
}
.footer__discord:hover{ border-color:var(--cyan); color:var(--cyan); }

/* =========================================================
   BACK TO TOP
   ========================================================= */
.back-to-top{
  position:fixed; right:20px; bottom:20px; z-index:150;
  width:44px; height:44px; border-radius:50%;
  background:var(--surface-2); border:1px solid var(--border-strong);
  display:flex; align-items:center; justify-content:center;
  opacity:0; pointer-events:none; transform:translateY(10px);
  transition:opacity .25s var(--ease), transform .25s var(--ease);
}
.back-to-top.is-visible{ opacity:1; pointer-events:auto; transform:translateY(0); }
.back-to-top:hover{ border-color:var(--cyan); color:var(--cyan); }

/* =========================================================
   REVEAL ON SCROLL
   ========================================================= */
.reveal{ opacity:0; transform:translateY(18px); transition:opacity .6s var(--ease), transform .6s var(--ease); }
.reveal.is-visible{ opacity:1; transform:translateY(0); }

/* =========================================================
   RESPONSIVE
   ========================================================= */
@media (max-width: 1024px){
  .feature-grid{ grid-template-columns:repeat(2, 1fr); }
  .game-grid{ grid-template-columns:repeat(2, 1fr); }
  .why-grid{ grid-template-columns:repeat(2, 1fr); }
  .mod-grid{ grid-template-columns:repeat(2, 1fr); }
  .stats__grid{ grid-template-columns:repeat(2, 1fr); }
  .hero__inner{ grid-template-columns:1fr; text-align:left; }
  .hero__panel{ order:-1; max-width:460px; }
  .economy__inner, .music__inner{ grid-template-columns:1fr; }
}

@media (max-width: 860px){
  .navbar__menu{ display:none; }
  .navbar__actions .btn--sm{ display:none; }
  .hamburger{ display:flex; }
  .mobile-menu{ display:flex; }
  .section__inner{ padding:64px 20px; }
}

@media (max-width: 640px){
  .feature-grid, .game-grid, .why-grid, .mod-grid, .stats__grid{ grid-template-columns:1fr; }
  .prefix__grid{ grid-template-columns:1fr; }
  .hero__actions .btn, .cta__actions .btn{ width:100%; }
  .hero__actions, .cta__actions{ flex-direction:column; }
  .terminal__body{ font-size:.82rem; }
  .ai-flow{ flex-direction:column; }
  .ai-flow__line{ width:2px; height:24px; background:linear-gradient(180deg, var(--violet), var(--cyan)); background-size:100% 200%; animation:flowV 2.4s linear infinite; }
  @keyframes flowV{ from{ background-position:0 200%; } to{ background-position:0 -200%; } }
  .ai__grid{ grid-template-columns:1fr; }
}

@media (max-width: 400px){
  .section__inner{ padding:52px 16px; }
}
